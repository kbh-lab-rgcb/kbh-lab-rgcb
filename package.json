{
  "name": "crp7-lab-website",
  "version": "1.0.0",
  "private": true,
  "description": "Website for Cancer Research Programme 7 (CRP7), BRIC-RGCB — every page is a folder anyone can edit.",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "build": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/build.ts",
    "dev": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/dev.ts",
    "check": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/build.test.mjs"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "marked": "^18.0.9",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
