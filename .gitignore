# Dependencies
/node_modules

# Build output. GitHub Actions rebuilds this on every push and publishes it
# directly, so it is not committed — that keeps generated files out of pull
# requests and avoids merge conflicts for people editing through the web UI.
/docs/

# Resized-image cache, rebuilt automatically.
/.cache/

# Editor and OS noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Logs
npm-debug.log*
*.log

# Environment
.env*
